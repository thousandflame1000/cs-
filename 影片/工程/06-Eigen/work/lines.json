  {"id": "o1", "text": "矩陣會把幾乎每個方向[轉歪]", "hook": true},
  {"id": "o2", "text": "只有兩個方向[不轉]", "hook": true, "pause": 0.1},
  {"id": "T", "text": "特徵向量", "card": true, "hold": 3.4},

  {"id": "a1", "text": "矩陣 A 作用在整個平面上", "scene": true},
  {"id": "a2", "text": "格子被拉成[平行四邊形]"},
  {"id": "a3", "text": "畫一圈箭頭，看每支怎麼動"},
  {"id": "a4", "text": "大部分箭頭都[轉了方向]", "pause": 0.2},

  {"id": "b1", "text": "但沿著 (1, 1) 的那支", "scene": true},
  {"id": "b2", "text": "只被拉長，變成 [3 倍]"},
  {"id": "b3", "text": "沿著 (1, −1) 的那支"},
  {"id": "b4", "text": "長度不變：倍率 [1]"},
  {"id": "b5", "text": "這就是 Av = [λ]v"},
  {"id": "b6", "text": "v 是[特徵向量]，λ 是[特徵值]", "pause": 0.2},

  {"id": "c1", "text": "怎麼算？讓 (A − λI)v = 0", "scene": true},
  {"id": "c2", "text": "要有非零解，行列式得是 [0]"},
  {"id": "c3", "text": "(2 − λ)² − 1 = 0"},
  {"id": "c4", "text": "λ = [3] 或 λ = [1]"},
  {"id": "c5", "text": "代回去：[(1, 1)] 和 [(1, −1)]", "pause": 0.2},

  {"id": "d1", "text": "整圈箭頭被拉成[橢圓]", "scene": true},
  {"id": "d2", "text": "長軸、短軸正是兩個特徵向量"},
  {"id": "d3", "text": "半軸長剛好是 [3] 和 [1]", "hold": 2.8},
